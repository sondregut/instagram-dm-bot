# Instagram/Meta App credentials
INSTAGRAM_APP_ID=123456789
INSTAGRAM_APP_SECRET=abc123...

# OAuth redirect URI (must match Meta Developer Portal)
OAUTH_REDIRECT_URI=https://us-central1-instagram-dm-bot-app.cloudfunctions.net/instagramOAuthCallback

# Web app URL
WEB_URL=https://instagram-dm-bot-app.web.app

# Webhook verification token (must match Meta Developer Portal)
VERIFY_TOKEN=your_random_secure_string_here

# Encryption key for storing access tokens (32+ characters)
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Anthropic API key for AI-powered responses
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Outbound safety mode: disabled | test | mindset | full
# Keep disabled until a preview is approved. Test mode allows only the configured
# target account and blocks the live MINDSET keyword.
BOT_MODE=disabled
MINDSET_AUTOMATION_ENABLED=false
MINDSET_TARGET_ACCOUNT_USERNAME=sondre_pv
MINDSET_TRIGGER_KEYWORD=AMDMTEST8472

# Athlete Mindset destinations
MINDSET_DOWNLOAD_REDIRECT_URL=https://us-central1-instagram-dm-bot-app.cloudfunctions.net/mindsetDownload
MINDSET_DOWNLOAD_DESTINATION=https://www.athletemindset.app/app
MINDSET_ACTIVATION_URL=https://us-central1-instagram-dm-bot-app.cloudfunctions.net/mindsetOpen

# Shared only with the Athlete Mindset RevenueCat webhook backend. In production,
# store this in Secret Manager as MINDSET_CONVERSION_SECRET rather than source control.
MINDSET_CONVERSION_SECRET=replace_with_a_long_random_value
